NODE_ENV=development
PORT=6103

# Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-do-not-use-in-production

# Database
DB_PATH=./data/audit.db

# Email credentials (provider is set in audit.config.ts → EMAIL.PROVIDER)
# In dev, OTP codes are logged to console — these are optional locally.
SMTP_USER=postmaster@icjia.cloud
SMTP_PASS=your-mailgun-smtp-password
# SMTP_FROM=admin@icjia.cloud          # optional — defaults to EMAIL.DEFAULT_FROM in config
# SMTP_HOST=                            # optional — defaults to provider host in config
# SMTP_PORT=                            # optional — defaults to provider port in config

# Limits
MAX_FILE_SIZE_MB=100
TMP_DIR=/tmp

# Ubuntu/bootstrap runtime paths for remediation features.
# scripts/bootstrap-ubuntu.sh writes concrete absolute paths into apps/api/.env.
# PYTHON_PATH=.local-tools/python/bin/python
# PDF_FONT_DIRS=.local-tools/fonts/legacy
# LEGACY_FONT_DIRS=.local-tools/fonts/legacy
# VERAPDF_PATH=.local-tools/verapdf/current/bin/verapdf
# JAVACMD=/usr/lib/jvm/java-17-openjdk-amd64/bin/java

# Admin
ADMIN_EMAILS=dev@test.illinois.gov

# Development: comma-separated extra domains for testing
ALLOWED_DOMAINS=illinois.gov

# OpenAI-compatible AI provider chain (used by remediation planner, semantic repair, page reconstruction)
#
# Local VM — Gemma 4 E2B Q4 via llama.cpp (see scripts/run-local-llm-gemma4-e2b.sh):
#   OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
#   OPENAI_COMPAT_API_KEY=local-dev-any-string
#   OPENAI_COMPAT_MODEL=<copy exact "id" from GET http://127.0.0.1:1234/v1/models>
#   OPENAI_COMPAT_TOOL_CHOICE_MODE=required
#   OPENAI_COMPAT_DISABLE_FALLBACKS=1
#
# Primary (example: remote or LAN OpenAI-compatible server)
# OPENAI_COMPAT_BASE_URL=http://192.168.50.238:1234/v1
# OPENAI_COMPAT_API_KEY=sk-lm-REPLACE_ME
# OPENAI_COMPAT_MODEL=google/gemma-4-26b-a4b
# OPENAI_COMPAT_TOOL_CHOICE_MODE=required
#
# Fallback 1
# OPENAI_COMPAT_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_FALLBACK_API_KEY=sk-or-v1-REPLACE_ME
# OPENAI_COMPAT_FALLBACK_MODEL=qwen/qwen3.6-plus:free
#
# Fallback 2
# OPENAI_COMPAT_SECONDARY_FALLBACK_BASE_URL=https://your-custom-endpoint.example.com/v1
# OPENAI_COMPAT_SECONDARY_FALLBACK_API_KEY=REPLACE_ME
# OPENAI_COMPAT_SECONDARY_FALLBACK_MODEL=openai/gpt-5.1-codex-mini
#
# Semantic timeout in milliseconds
# SEMANTIC_REQUEST_TIMEOUT_MS=12000
#
# Figure alt-text batches: default sends crops as OpenAI image_url parts (vision). Legacy base64-inside-JSON only if needed:
# SEMANTIC_REPAIR_INLINE_FIGURE_IMAGES=1
