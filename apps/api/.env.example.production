NODE_ENV=production
PORT=6103

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE-WITH-REAL-SECRET

# Database
DB_PATH=./data/audit.db

# Email credentials (provider is set in audit.config.ts → EMAIL.PROVIDER)
SMTP_USER=postmaster@icjia.cloud
SMTP_PASS=REPLACE-WITH-REAL-PASSWORD

# Limits
MAX_FILE_SIZE_MB=100
TMP_DIR=/tmp

# Admin — comma-separated list of admin email addresses
ADMIN_EMAILS=REPLACE-WITH-REAL-ADMIN-EMAILS

# Production: leave empty — only illinois.gov regex is enforced
# Ubuntu/bootstrap runtime paths for remediation features.
# PYTHON_PATH=/opt/file-accessibility-audit/.local-tools/python/bin/python
# PDF_FONT_DIRS=/opt/file-accessibility-audit/.local-tools/fonts/legacy
# LEGACY_FONT_DIRS=/opt/file-accessibility-audit/.local-tools/fonts/legacy
# VERAPDF_PATH=/opt/file-accessibility-audit/.local-tools/verapdf/current/bin/verapdf
# JAVACMD=/usr/lib/jvm/java-17-openjdk-amd64/bin/java
ALLOWED_DOMAINS=

# OpenAI-compatible AI provider chain
#
# On-VM Gemma 4 E2B Q4 (llama.cpp): bash scripts/run-local-llm-gemma4-e2b.sh
#   OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
#   OPENAI_COMPAT_API_KEY=local-or-random-non-empty
#   OPENAI_COMPAT_MODEL=<id from GET .../v1/models>
#   OPENAI_COMPAT_TOOL_CHOICE_MODE=required
#   OPENAI_COMPAT_DISABLE_FALLBACKS=1
#
# Primary
# OPENAI_COMPAT_BASE_URL=http://192.168.50.238:1234/v1
# OPENAI_COMPAT_API_KEY=sk-lm-REPLACE-WITH-REAL-KEY
# OPENAI_COMPAT_MODEL=google/gemma-4-26b-a4b
# OPENAI_COMPAT_TOOL_CHOICE_MODE=required
#
# Fallback 1
# OPENAI_COMPAT_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_FALLBACK_API_KEY=REPLACE-WITH-REAL-KEY
# OPENAI_COMPAT_FALLBACK_MODEL=qwen/qwen3.6-plus:free
#
# Fallback 2
# OPENAI_COMPAT_SECONDARY_FALLBACK_BASE_URL=https://your-custom-endpoint.example.com/v1
# OPENAI_COMPAT_SECONDARY_FALLBACK_API_KEY=REPLACE-WITH-REAL-KEY
# OPENAI_COMPAT_SECONDARY_FALLBACK_MODEL=openai/gpt-5.1-codex-mini
#
# Semantic timeout in milliseconds
# SEMANTIC_REQUEST_TIMEOUT_MS=12000
