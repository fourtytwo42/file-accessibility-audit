NODE_ENV=production
PORT=6103

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE-WITH-REAL-SECRET

# Database
DB_PATH=./data/audit.db

# Email credentials (provider is set in audit.config.ts → EMAIL.PROVIDER)
SMTP_USER=postmaster@icjia.cloud
SMTP_PASS=REPLACE-WITH-REAL-PASSWORD

# Limits
MAX_FILE_SIZE_MB=100
TMP_DIR=/tmp

# Admin — comma-separated list of admin email addresses
ADMIN_EMAILS=REPLACE-WITH-REAL-ADMIN-EMAILS

# Production: leave empty — only illinois.gov regex is enforced
# Ubuntu/bootstrap runtime paths for remediation features.
# PYTHON_PATH=/opt/file-accessibility-audit/.local-tools/python/bin/python
# PDF_FONT_DIRS=/opt/file-accessibility-audit/.local-tools/fonts/legacy
# LEGACY_FONT_DIRS=/opt/file-accessibility-audit/.local-tools/fonts/legacy
# VERAPDF_PATH=/opt/file-accessibility-audit/.local-tools/verapdf/current/bin/verapdf
# JAVACMD=/usr/lib/jvm/java-17-openjdk-amd64/bin/java
ALLOWED_DOMAINS=
