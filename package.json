{
  "name": "file-accessibility-audit",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:ubuntu": "bash ./scripts/bootstrap-ubuntu.sh",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "kill-port 6103 && pnpm --filter api dev",
    "dev:web": "kill-port 6102 && pnpm --filter web dev",
    "orchestrator": "tsx scripts/remediation-orchestrator.ts",
    "orchestrator:validate": "tsx scripts/remediation-orchestrator.ts --validate-only",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "test": "tsx scripts/test.ts",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:scoring": "pnpm --filter api test:scoring",
    "test:regressions": "pnpm --filter api test:regressions",
    "baseline:phase0": "pnpm --filter api baseline:phase0",
    "baseline:phase0:canary": "pnpm --filter api baseline:phase0:canary",
    "baseline:phase0:compare": "pnpm --filter api baseline:phase0:compare",
    "baseline:processed:pairs": "pnpm --filter api baseline:processed:pairs",
    "baseline:processed:capability": "pnpm --filter api baseline:processed:capability",
    "baseline:processed:font-capability": "pnpm --filter api baseline:processed:font-capability",
    "diagnose:processed-intake-parity": "pnpm --filter api diagnose:processed-intake-parity",
    "diagnose:live-families": "pnpm --filter api diagnose:live-families",
    "trace:full-audit-tail": "pnpm --filter api trace:full-audit-tail",
    "trace:link-family": "pnpm --filter api trace:link-family",
    "trace:97anreport": "pnpm --filter api trace:97anreport",
    "trace:annual-reports": "pnpm --filter api trace:annual-reports",
    "trace:long-reports": "pnpm --filter api trace:long-reports",
    "trace:long-report-figures": "pnpm --filter api trace:long-report-figures",
    "trace:font-cluster": "pnpm --filter api trace:font-cluster",
    "verify:processed:capability": "pnpm --filter api verify:processed:capability",
    "verify:processed:font-capability": "pnpm --filter api verify:processed:font-capability",
    "verify:regressions": "pnpm --filter api verify:regressions",
    "verify:env": "bash ./scripts/verify-env.sh",
    "agency:test": "tsx scripts/test-agency-strapi.ts",
    "agency:backup-pdfs": "tsx scripts/backup-icjia-pdfs.ts",
    "agency:build-replacement-map": "tsx scripts/build-icjia-replacement-map.ts",
    "agency:sync-server-cache": "tsx scripts/sync-icjia-server-cache.ts",
    "agency:seed-complete-replacements": "tsx scripts/seed-complete-replacements.ts",
    "agency:enrich-checksums": "tsx scripts/enrich-icjia-checksums.ts",
    "agency:scan-remaining": "tsx scripts/scan-remaining-publication-pdfs.ts",
    "agency:build-priority-list": "tsx scripts/build-remediation-priority-list.ts",
    "agency:build-next-batch": "tsx scripts/build-next-remediation-batch.ts",
    "agency:build-control-plane": "tsx scripts/build-corpus-control-plane.ts",
    "agency:validate-control-plane": "tsx scripts/validate-corpus-control-plane.ts",
    "agency:run-priority-remediation": "tsx scripts/run-priority-remediation-batch.ts",
    "agency:verify-ready": "tsx scripts/verify-ready-to-replace.ts",
    "agency:benchmark-remediation": "tsx scripts/run-remediation-regression-benchmark.ts",
    "start:all": "kill-port 6103 6102 && sleep 1 && echo '\\n[start:all] API → http://localhost:6103  |  WEB → http://localhost:6102\\n' && PORT=6103 pnpm --filter api start & PORT=6102 pnpm --filter web start & wait",
    "clean": "rm -rf apps/web/.nuxt apps/web/.output apps/web/node_modules/.vite apps/api/dist node_modules/.cache && echo 'Cleaned all caches'",
    "rebrand": "tsx scripts/rebrand.ts",
    "agency:build-stage2-short-wave": "tsx scripts/build-stage2-short-cohort-wave.ts",
    "agency:run-stage2-short-wave": "tsx scripts/run-stage2-short-cohort-wave.ts",
    "agency:build-stage3-figure-wave": "tsx scripts/build-stage3-figure-wave.ts",
    "agency:run-stage3-figure-wave": "tsx scripts/run-stage3-figure-wave.ts",
    "agency:build-stage4-structure-wave": "tsx scripts/build-stage4-structure-wave.ts",
    "agency:analyze-stage4-structure-pending": "tsx scripts/analyze-stage4-structure-pending.ts",
    "agency:analyze-stage4-structure-active": "tsx scripts/analyze-stage4-structure-active.ts",
    "agency:analyze-stage4-structure-stalled": "tsx scripts/analyze-stage4-structure-stalled.ts",
    "agency:run-stage4-structure-wave": "tsx scripts/run-stage4-structure-wave.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0"
  }
}
