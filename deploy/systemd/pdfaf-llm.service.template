[Unit]
Description=PDFAF Local Gemma llama.cpp service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__REPO_ROOT__
Environment=HOME=__HOME_DIR__
ExecStart=__REPO_ROOT__/scripts/run-local-llm-gemma4-e2b.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
